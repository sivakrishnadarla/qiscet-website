# Local dev
PORT=4000
# Comma-separated origins allowed to call the API directly. The Next.js app proxies /api, so this is only needed for direct calls.
CORS_ORIGIN=http://localhost:3000,https://www.qiscet.edu.in

# --- Sinks: enable any combination. If none are set, submissions are logged and written to data/submissions.jsonl ---

# Email (Nodemailer). Works with Gmail app passwords, Zoho, Amazon SES, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admissions@qiscet.edu.in
SMTP_PASS=app-password-here
MAIL_FROM="QISCET Website <admissions@qiscet.edu.in>"
MAIL_TO=principal@qiscet.edu.in
MAIL_TO_ADMISSIONS=principal@qiscet.edu.in
MAIL_TO_CONTACT=principal@qiscet.edu.in
MAIL_TO_GRIEVANCE=principal@qiscet.edu.in
MAIL_TO_FEEDBACK=principal@qiscet.edu.in

# MongoDB Atlas (free tier). Submissions land in the `submissions` collection.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net
MONGODB_DB=qiscet

# Google Sheets: deploy an Apps Script web app that appends JSON rows, paste its /exec URL here.
SHEETS_WEBHOOK_URL=

# Protects GET /api/admin/submissions (header: x-admin-token)
ADMIN_TOKEN=change-me
