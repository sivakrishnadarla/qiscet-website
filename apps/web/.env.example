# Public site URL (used for canonical URLs, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.qiscet.edu.in
# NestJS API base URL (the /api/* routes are proxied to this host by next.config.mjs)
API_URL=https://qiscet-api.vercel.app
# Optional analytics
NEXT_PUBLIC_GTM_ID=GTM-W4F7HD49

# --- Staff CMS (pages, blog, gallery) ---
# Local preview accepts admin / qiscet-admin and staff / qiscet-staff until these are set.
# On Vercel, login is disabled until CMS_ADMIN_PASSWORD is set.
CMS_ADMIN_USER=admin
CMS_ADMIN_PASSWORD=choose-a-long-password
CMS_STAFF_USER=staff
CMS_STAFF_PASSWORD=choose-another-long-password
CMS_SECRET=random-string-used-to-sign-login-cookies

# auto = files when running locally (commit content/cms and public/uploads), MongoDB on Vercel.
# Set mongo to always use Atlas. Set file to always write JSON into the repo.
CMS_STORE=auto
# Same Atlas URI can be used by the API project. Required for live edits on Vercel.
MONGODB_URI=
MONGODB_DB=qiscet
