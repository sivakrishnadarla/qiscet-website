  {
   "type": "heading",
   "text": "Rules and Regulations of the Competitions",
   "level": 4
  },
  {
   "type": "list",
   "ordered": false,
   "items": [
    {
     "text": "All the teams and individuals requested to report at the respective ground and places as maintained by the event coordinator"
    },
    {
     "text": "If a team comes individually late the team has individual would be considers a walk over"
    },
    {
     "text": "The matches will be played knock out basis"
    },
    {
     "text": "Referee decision is final in all matches"
    },
    {
     "text": "Draw will be taken by department of physical education and coordinators"
    }
   ]
  },
  {
   "type": "heading",
   "text": "Rules of College team selections",
   "level": 4
  },
  {
   "type": "list",
   "ordered": false,
   "items": [
    {
     "text": "Skill of their games performance and playing ability performance"
    },
    {
     "text": "Character of discipline in the college"
    },
    {
     "text": "The Players who selected college team in any event he/she should obey the rules of departments"
    },
    {
     "text": "If any player found indiscipline character will be send out immediately. Both physical director and sports coordinator will be the selectors for the college team"
    }
   ]
  },
  {
   "type": "heading",
   "text": "Working Hours",
   "level": 4
  },
  {
   "type": "list",
   "ordered": false,
   "items": [
    {
     "text": "Gym (3.00 PM onwards) A modern gymnasium with latest equipment is provided for the physical fitness of the students giving proper training to the students"
    }
   ]
  },
  {
   "type": "heading",
   "text": "Gymnasium Rules",
   "level": 4
  },
  {
   "type": "list",
   "ordered": false,
   "items": [
    {
     "text": "Every student will be allowed 60 Min per day"
    },
    {
     "text": "Do not eat before exercise"
    },
    {
     "text": "Do not enter with chapels, wear sports shoes"
    },
    {
     "text": "Wear a Tea shirt and Lower track"
    },
    {
     "text": "Bring One small towel to wipe your sweat"
    },
    {
     "text": "Handle equipment gently"
    },
    {
     "text": "Maintain strict silence"
    },
    {
     "text": "Do not run, shout and drag inside the gym"
    }
   ]
  },
